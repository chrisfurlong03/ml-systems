   },
   "source": [
    "## Step 3: Normalize Data\n",
    "\n",
    "The next step is to normalize the data by subtracting the mean and dividing by the standard deviation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {
    "colab": {
     "autoexec": {
      "startup": false,
      "wait_interval": 0
     }
    },
    "colab_type": "code",
    "id": "OYjZ7VNK5adM"
   },
   "outputs": [],
   "source": [
    "numerical_cols = ['Length', 'device_timebin_bandwidth', 'device_timebin_num_dest',\n",
    "                  'device_timebin_delta_num_dest', 'dT', 'dT2', 'dT3']\n",
    "categorical_cols = ['is_HTTP', 'is_TCP', 'is_UDP', 'is_OTHER']\n",
    "\n",
    "# rescale numerical columns to standard normal\n",
    "numerical = all_features[numerical_cols]\n",
    "numerical = (numerical - np.mean(numerical, axis=0)) / np.std(numerical, axis=0)\n",
    "# rescale categorical columns from [0,1] to [-1,1]\n",
    "categorical = all_features[categorical_cols] * 2 - 1\n",
    "# recombine data\n",
    "all_features = pd.concat([numerical, categorical], axis=1)"
   ]
  },
